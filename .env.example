# Copia questo file in ".env" e compila i valori reali.
# In produzione (Render) questi stessi nomi vanno inseriti come "Environment Variables"
# nel pannello del servizio — non caricare mai il file ".env" vero su GitHub.

# Stringa di connessione del database Postgres (da Neon: Dashboard -> Connection string)
DATABASE_URL=postgresql://utente:password@host/nomedatabase?sslmode=require

# Stringa casuale lunga e segreta, usata per firmare i cookie di sessione.
# Generane una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambia-questa-stringa-con-una-generata-casualmente

# Render la imposta da sola in produzione — serve solo se testi in locale
NODE_ENV=development
PORT=3000
